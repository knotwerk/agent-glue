{
  "version": "0.1.82",
  "activationEvents": [
    "onStartupFinished"
  ],
  "publisher": "knotwerk",
  "engines": {
    "vscode": "^1.100.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knotwerk/agent-glue.git"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "name": "agent-glue-companion",
  "displayName": "Agent Glue Companion",
  "description": "Find agent files across projects, preview Markdown and HTML, review PRs, and track tasks beside your CLI terminals.",
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "agentGlue.preview",
        "title": "Agent Glue: Preview Document"
      },
      {
        "command": "agentGlue.draft",
        "title": "Agent Glue: Open Dictation Draft"
      },
      {
        "command": "agentGlue.layout",
        "title": "Agent Glue: Toggle Right Sidebar Layout"
      },
      {
        "command": "agentGlue.pin",
        "title": "Agent Glue: Pin File",
        "icon": "$(pin)"
      },
      {
        "command": "agentGlue.installInstructions",
        "title": "Agent Glue: Install Agent Instructions"
      },
      {
        "command": "agentGlue.dictate",
        "title": "Agent Glue: Dictate Note"
      },
      {
        "command": "agentGlue.showfiles",
        "title": "Agent Glue: Files",
        "icon": "$(files)"
      },
      {
        "command": "agentGlue.showprs",
        "title": "Agent Glue: Pull requests",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "agentGlue.refreshResources",
        "title": "Agent Glue: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentGlue.clearFiles",
        "title": "Agent Glue: Clear recent files",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentGlue.chooseSession",
        "title": "Agent Glue: Choose Session"
      },
      {
        "command": "agentGlue.showtasks",
        "title": "Agent Glue: Terminal Status",
        "icon": "$(pulse)"
      },
      {
        "command": "agentGlue.fork",
        "title": "Agent Glue: Fork Conversation",
        "icon": "$(repo-forked)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentGlue.webApps",
        "title": "Agent Glue: Show All Web Apps"
      },
      {
        "command": "agentGlue.tryTerminalSelector",
        "title": "Agent Glue: Try Terminal Selector Beside Terminals",
        "icon": "$(list-selection)"
      },
      {
        "command": "agentGlue.resetTerminalSelector",
        "title": "Agent Glue: Move Terminal Selector Back"
      },
      {
        "command": "agentGlue.splitSelectorTerminal",
        "title": "Split Terminal",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "agentGlue.enableLiveStatus",
        "title": "Agent Glue: Enable Live Terminal Status",
        "icon": "$(pulse)"
      },
      {
        "command": "agentGlue.newSelectorTerminal",
        "title": "New Terminal (Choose Profile)",
        "icon": "$(add)"
      },
      {
        "command": "agentGlue.renameSelectorTerminal",
        "title": "Rename Terminal",
        "icon": "$(edit)"
      },
      {
        "command": "agentGlue.moveSelectorTerminal",
        "title": "Move to Own Terminal",
        "icon": "$(ungroup-by-ref-type)"
      },
      {
        "command": "agentGlue.linkCodexStatus",
        "title": "Link Codex Status\u2026"
      },
      {
        "command": "agentGlue.newSelectorShell",
        "title": "New Terminal"
      },
      {
        "command": "agentGlue.markSelectorUnread",
        "title": "Mark Unread"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentGlue",
          "title": "Agent Glue",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "agentGlueSelector",
          "title": "Terminals",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentGlue": [
        {
          "type": "webview",
          "id": "agentGlue.companion",
          "name": "Agent Glue"
        }
      ],
      "agentGlueSelector": [
        {
          "id": "agentGlue.terminalSelector",
          "name": "Terminals",
          "visibility": "hidden"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "agentGlue.preview",
          "when": "resourceExtname == .md || resourceExtname == .html",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "agentGlue.showfiles",
          "when": "view == agentGlue.companion",
          "group": "navigation@1"
        },
        {
          "command": "agentGlue.showprs",
          "when": "view == agentGlue.companion",
          "group": "navigation@2"
        },
        {
          "command": "agentGlue.refreshResources",
          "when": "view == agentGlue.companion",
          "group": "navigation@3"
        },
        {
          "command": "agentGlue.pin",
          "when": "view == agentGlue.companion && agentGlue.resourceTab == files",
          "group": "fileActions@1"
        },
        {
          "command": "agentGlue.clearFiles",
          "when": "view == agentGlue.companion && agentGlue.resourceTab == files",
          "group": "fileActions@2"
        },
        {
          "command": "agentGlue.chooseSession",
          "when": "view == agentGlue.companion",
          "group": "fileActions@3"
        },
        {
          "command": "agentGlue.showtasks",
          "when": "view == agentGlue.companion",
          "group": "navigation@2.5"
        },
        {
          "command": "agentGlue.tryTerminalSelector",
          "when": "view == terminal",
          "group": "navigation@9"
        },
        {
          "command": "agentGlue.resetTerminalSelector",
          "when": "view == agentGlue.terminalSelector",
          "group": "2_layout"
        },
        {
          "command": "agentGlue.enableLiveStatus",
          "when": "view == agentGlue.terminalSelector",
          "group": "2_status"
        },
        {
          "command": "agentGlue.newSelectorTerminal",
          "when": "view == agentGlue.terminalSelector",
          "group": "navigation@1"
        }
      ],
      "terminal/title/context": [
        {
          "command": "agentGlue.fork",
          "when": "isWorkspaceTrusted",
          "group": "1_create@0"
        }
      ],
      "terminal/context": [
        {
          "command": "agentGlue.fork",
          "when": "isWorkspaceTrusted",
          "group": "1_create@0"
        }
      ],
      "view/item/context": [
        {
          "command": "agentGlue.splitSelectorTerminal",
          "when": "view == agentGlue.terminalSelector",
          "group": "inline@2"
        },
        {
          "command": "agentGlue.fork",
          "when": "view == agentGlue.terminalSelector && viewItem =~ /^agentGlueAgent/",
          "group": "inline@1"
        },
        {
          "command": "agentGlue.renameSelectorTerminal",
          "when": "view == agentGlue.terminalSelector",
          "group": "1_manage@1"
        },
        {
          "command": "agentGlue.moveSelectorTerminal",
          "when": "view == agentGlue.terminalSelector && viewItem =~ /GroupTerminal$|SplitTerminal$/",
          "group": "1_manage@2"
        },
        {
          "command": "agentGlue.linkCodexStatus",
          "when": "view == agentGlue.terminalSelector && viewItem =~ /^agentGlueAgent/",
          "group": "2_status"
        },
        {
          "command": "agentGlue.newSelectorShell",
          "when": "view == agentGlue.terminalSelector",
          "group": "1_manage@0"
        },
        {
          "command": "agentGlue.markSelectorUnread",
          "when": "view == agentGlue.terminalSelector && viewItem =~ /^agentGlueAgent/",
          "group": "2_status@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentGlue.splitSelectorTerminal",
          "when": "false"
        },
        {
          "command": "agentGlue.renameSelectorTerminal",
          "when": "false"
        },
        {
          "command": "agentGlue.moveSelectorTerminal",
          "when": "false"
        },
        {
          "command": "agentGlue.linkCodexStatus",
          "when": "false"
        },
        {
          "command": "agentGlue.newSelectorShell",
          "when": "false"
        },
        {
          "command": "agentGlue.markSelectorUnread",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentGlue.dictate",
        "key": "ctrl+alt+d",
        "mac": "ctrl+alt+d",
        "when": "isWorkspaceTrusted"
      }
    ]
  },
  "preview": true,
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "codex",
    "ssh",
    "markdown",
    "pull requests",
    "files"
  ],
  "homepage": "https://github.com/knotwerk/agent-glue#readme",
  "bugs": {
    "url": "https://github.com/knotwerk/agent-glue/issues"
  }
}
